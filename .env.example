# Compose-level configuration for `docker compose up`. Copy to `.env` (repo root, next
# to docker-compose.yml) only if you need to override a default — every variable below
# already has a working value and `docker compose up --build` works with none of this
# present. Never commit a real `.env` with a real APP_AI_API_KEY.
#
# Per-service local (non-Docker) development uses backend/.env.example and
# frontend/.env.example instead — this file is Compose-only.

# Host ports the two containers are published on.
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Passed straight through to the backend container — see backend/.env.example for what
# each one does. AI defaults to "offline": zero configuration, zero network calls.
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
APP_MAX_UPLOAD_SIZE_BYTES=52428800
APP_AI_PROVIDER=offline
APP_AI_MODEL=
APP_AI_API_KEY=
APP_AI_BASE_URL=https://api.anthropic.com
APP_AI_TIMEOUT_SECONDS=30

# Baked into the frontend's static build at image-build time — Vite env vars cannot
# change at container runtime, so this must match wherever the backend is actually
# reachable from your browser. Update it if you change BACKEND_PORT above.
VITE_API_BASE_URL=http://localhost:8000
