# Copy to .env for local overrides. Never commit the real .env file.
APP_APP_ENV=development
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dataset ingestion (Phase 02) — see 02_DOCS/decisions/DECISIONS_LOG.md ADR-005/ADR-010.
