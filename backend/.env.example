# Copy to .env for local overrides. Never commit the real .env file.
APP_APP_ENV=development
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dataset ingestion (Phase 02) — see 02_DOCS/decisions/DECISIONS_LOG.md ADR-005/ADR-010.
APP_DATA_DIR=data/uploads
APP_MAX_UPLOAD_SIZE_BYTES=52428800

# AI analytics (Phase 05) — see 02_DOCS/decisions/DECISIONS_LOG.md ADR-014.
# Default "offline" needs nothing below and makes zero network calls. Set to "anthropic"
# only if you want real LLM-generated explanations, and provide APP_AI_API_KEY yourself —
# NEVER commit a real key here or anywhere in this repo. Set to "disabled" to turn the
# entire AI layer off.
APP_AI_PROVIDER=offline
APP_AI_MODEL=
APP_AI_API_KEY=
APP_AI_BASE_URL=https://api.anthropic.com
APP_AI_TIMEOUT_SECONDS=30
